{
  // F5 — installs packages if needed, starts MegaShop and opens it in the browser.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "▶ MegaShop иштетүү",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "preLaunchTask": "npm install",
      "serverReadyAction": {
        "pattern": "- Local:.+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ]
}
